# ---------------------------------------------------------------------------
# Copy this file to .env on the server and fill in the real values.
# .env is gitignored, so credentials never reach the repository.
# ---------------------------------------------------------------------------

# Database — from hPanel → Databases → Management
DB_HOST=localhost
DB_NAME=uXXXXXXXX_oradent
DB_USER=uXXXXXXXX_oradent
DB_PASS=change-this-to-the-real-password
DB_PORT=3306

# Public base URL, no trailing slash
SITE_URL=https://oradentdentalcare.com

# Leave false in production — true prints database errors to the browser
APP_DEBUG=false
